# Supabase PostgreSQL pooler URL used by the running application.
# Supabase Dashboard -> Connect -> ORMs -> Transaction pooler.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Supabase direct/session URL used only by migrations and controlled seed jobs.
# Use the direct URL when the host supports IPv6; otherwise use the session pooler on port 5432.
DATABASE_URL_UNPOOLED=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Public Supabase project settings. These are safe to expose to browser code, but they do not grant schema access.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Development-only root secret (min 32 bytes, base64 or hex). Generate: openssl rand -base64 48.
# CUIS refuses this provider when NODE_ENV=production.
MASTER_SECRET=
# Active legacy Ed25519 and CUIS key version (integer, 1-255).
SIGNING_KEY_VERSION=1
# Local development: development. Production: managed, with versioned secrets injected by the
# deployment's managed secret/KMS integration (CUIS_KEY_V1, CUIS_KEY_V2, ...).
CUIS_KEY_PROVIDER=development
CUIS_KEY_V1=
# Comma-separated compromised versions. Revoked versions fail QR authentication immediately.
REVOKED_KEY_VERSIONS=
# Enables database-backed demo shortcuts, location simulation and demo reset. Keep false in production.
DEMO_MODE=false
DEMO_PASSWORD=pitch-demo-2026

# One-time platform administrator bootstrap (run npm run db:bootstrap-admin, then remove these values)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
