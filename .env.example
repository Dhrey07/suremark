# PostgreSQL connection string (Vercel + Neon sets this automatically)
DATABASE_URL=postgres://postgres@127.0.0.1:5432/upa
# Root secret for the simulated KMS (min 32 bytes, base64 or hex). Generate: openssl rand -base64 48
MASTER_SECRET=
# Active Ed25519 signing key version (integer, 1-255)
SIGNING_KEY_VERSION=1
# Enables demo sign-in shortcuts, location simulation and demo reset
DEMO_MODE=true
DEMO_PASSWORD=pitch-demo-2026
